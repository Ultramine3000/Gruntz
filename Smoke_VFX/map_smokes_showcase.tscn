[sub_resource type="GDScript" id="GDScript_xihgf"]
resource_name = "VFX_showcaser"
script/source = "@tool
extends Node

enum {ANTICIPATION, HIT}

@export var my_bool:bool = false:
	set(new_my_bool):
		my_bool = new_my_bool
		self.play_all_animations(my_bool)

func _ready() -> void:
	$misc/AnimationPlayer.play(\"Init\")

func _run():
	$misc/AnimationPlayer.play(\"Init\")

	
func play_all_animations(_type:bool)->void:
	
	match _type:
		true:
			$VFX_Puff_styleB.find_child(\"AnimationPlayer\").play(\"Init\");
			$VFX_Puff_StyleC.find_child(\"AnimationPlayer\").play(\"Init\");
			
		false:
			$VFX_Puff_StyleColored.find_child(\"AnimationPlayer\").play(\"Init\");
			$VFX_Puff_hit.find_child(\"AnimationPlayer\").play(\"Init\");
"

